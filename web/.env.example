# Leave NEXT_PUBLIC_PROGRAM_ID empty for demo mode (draws simulated in the browser, no real funds)
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_USDC_MINT=

# Server only
# Devnet test USDC mint authority as a JSON byte array; enables the + Test USDC button
FAUCET_SECRET_KEY=
JUP_API_KEY=
JUP_SLIPPAGE_BPS=100
JUP_PLATFORM_FEE_BPS=
JUP_FEE_ACCOUNT=

# Leverage Box: MagicBlock Ephemeral Rollup endpoint (defaults to the public devnet endpoint in Asia)
NEXT_PUBLIC_ER_RPC_URL=
